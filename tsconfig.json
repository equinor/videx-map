{
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "outDir": "./dist",
    "target": "ES2022",
    "esModuleInterop": true,
    "types": ["vitest/globals", "node"],
    "resolveJsonModule": true,
    "allowJs": true
  },
  "include": [
    "./src"
  ],
  "exclude": ["node_modules"],
}
